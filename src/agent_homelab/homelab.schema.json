{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.net/agent-homelab/schema/v1",
  "title": "Agent Homelab inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site", "nodes", "services"],
  "properties": {
    "schema_version": {"const": 1},
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "timezone"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "certificate_resolver": {"type": "string", "default": "letsencrypt"},
        "authelia": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {"type": "string", "format": "uri"},
            "session_secret_ref": {"$ref": "#/$defs/secretRef"},
            "storage_encryption_key_ref": {"$ref": "#/$defs/secretRef"}
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/node"}
    },
    "services": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/service"}
    }
  },
  "$defs": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {"env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}}
    },
    "connect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "ssh_alias": {"type": "string", "minLength": 1}
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["local", "ssh"]},
        "root": {"type": "string", "minLength": 1},
        "state_root": {"type": "string", "minLength": 1},
        "validate_command": {"type": "array", "items": {"type": "string"}},
        "reload_command": {"type": "array", "items": {"type": "string"}}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "connect"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["service_host", "edge_gateway"]}
        },
        "connect": {"$ref": "#/$defs/connect"},
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"scheme": {"enum": ["http", "https"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "deploy": {"$ref": "#/$defs/deploy"},
        "edge": {"$ref": "#/$defs/edge"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "description": "Edge ingress shape. direct (default when absent): Traefik terminates TLS on :443. tunnel: a Cloudflare Tunnel delivers HTTP to loopback-published Traefik entrypoints.",
      "properties": {
        "mode": {"enum": ["direct", "tunnel"]},
        "trusted_ips": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Hops allowed to set X-Forwarded-* (the cloudflared or Docker-proxy hop). Never 0.0.0.0/0."
        },
        "docker_gateway": {"type": "string", "minLength": 1, "description": "Docker network gateway used by host-service bridge sockets."},
        "client_ip_header": {"type": "string", "default": "Cf-Connecting-IP"},
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["average", "burst"],
          "properties": {"average": {"type": "integer", "minimum": 1}, "burst": {"type": "integer", "minimum": 1}}
        },
        "entrypoints": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["port"],
            "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
          }
        },
        "authelia": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "entrypoint"],
          "properties": {
            "hostname": {"type": "string", "minLength": 1},
            "entrypoint": {"type": "string", "minLength": 1},
            "address": {"type": "string", "format": "uri"}
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "entrypoint"],
          "properties": {"hostname": {"type": "string", "minLength": 1}, "entrypoint": {"type": "string", "minLength": 1}}
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "scheme", "host", "port", "port_source"],
      "properties": {
        "node": {"type": "string", "minLength": 1},
        "scheme": {"enum": ["http", "https"]},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "port_source": {"type": "string", "minLength": 1},
        "allow_ephemeral_port": {"type": "boolean", "default": false},
        "bridge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "description": "Expose a host-loopback service to the Traefik container through a systemd socket proxy on the Docker gateway.",
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "requires_unit": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "pathRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path_prefix", "upstream"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path_prefix": {"type": "string", "pattern": "^/"},
        "upstream": {"$ref": "#/$defs/upstream"},
        "middlewares": {"type": "array", "items": {"type": "string"}},
        "headers": {"type": "object", "description": "Traefik headers middleware options for this path route on a tunnel edge."}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream"],
      "properties": {
        "upstream": {"$ref": "#/$defs/upstream"},
        "forward_auth": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address"],
            "properties": {
              "address": {"type": "string", "format": "uri"},
              "trust_forward_header": {"type": "boolean", "default": true},
              "auth_response_headers": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}, "hostname": {"type": "string"}}
        },
        "public": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "hostname": {"type": "string"},
            "edge_node": {"type": "string"},
            "entrypoint": {"type": "string", "default": "websecure"},
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "policy"],
              "properties": {
                "provider": {"const": "authelia"},
                "policy": {"enum": ["one_factor", "two_factor", "bypass", "deny"]}
              }
            },
            "headers": {"type": "object", "description": "Traefik headers middleware options for this public router on a tunnel edge."},
            "oauth_mcp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["upstream"],
              "description": "OAuth-protected MCP: protected-resource metadata and /mcp route to this upstream without forward-auth.",
              "properties": {"upstream": {"$ref": "#/$defs/upstream"}}
            }
          }
        },
        "path_routes": {"type": "array", "items": {"$ref": "#/$defs/pathRoute"}}
      }
    }
  }
}
